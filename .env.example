# AWS credentials for Amazon Bedrock (used by the execution engine)
# Configure a named profile in ~/.aws/credentials or use standard AWS env vars.
AWS_PROFILE=bedrock
AWS_REGION=eu-west-1

# Optional: override defaults from config.json
# DEFAULT_MODEL=eu.anthropic.claude-sonnet-4-6
# CLAUDE_CLI_PATH=claude

# Next.js
PORT=3000
