# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# local runtime data (agents, tasks, teams)
/data/tasks/*.json
/data/agents/*/
/data/teams/*.json
/workspace/

# editor / tooling
.claude/

# vercel
.vercel

# python virtual env
.venv

# typescript
*.tsbuildinfo
next-env.d.ts
.worktrees/
